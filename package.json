{
  "name": "@rentalhost/rheactor-components",
  "version": "1.0.20",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#storybook/*": "./.storybook/*",
    "#assets/*": "./public/assets/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": {
      "default": "./src/theme.css"
    }
  },
  "scripts": {
    "dev": "storybook dev -p 9009",
    "build": "rimraf ./dist && tspc -p ./tsconfig.build.json && swc ./dist -d .",
    "oxfmt": "oxfmt --check ./.storybook ./src",
    "oxfmt:fix": "oxfmt --write ./.storybook ./src",
    "eslint": "eslint ./.storybook ./src",
    "eslint:fix": "eslint --fix ./.storybook ./src",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.10",
    "@rentalhost/rheactor-core": "github:rentalhost/rheactor-core",
    "@rheactor/rheactor-font-awesome": "^7.2.0",
    "domhandler": "^6.0.1",
    "get-video-id": "^4.2.0",
    "htmlparser2": "^12.0.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-style-stringify": "^1.2.0",
    "style-to-js": "^2.0.2",
    "swiper": "^14.0.2"
  },
  "devDependencies": {
    "@rheactor/eslint-config-rheactor": "github:rheactor/eslint-config-rheactor",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/csf": "^0.1.13",
    "@storybook/nextjs": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@tailwindcss/postcss": "^4.3.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "oxfmt": "^0.58.0",
    "rimraf": "^6.1.3",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.2",
    "ts-patch": "^4.0.1",
    "typescript": "^7.0.2",
    "typescript-transform-paths": "^4.0.0",
    "vite": "^8.1.3"
  }
}
